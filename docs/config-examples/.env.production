# Production Configuration
# ========================
# Comprehensive configuration for production deployment.
# Copy to .env and customize with your values.

# PostgreSQL Database Configuration
# ================================
# These variables configure the PostgreSQL database that stores all trading reports,
# analyses, and system logs. All services depend on these settings.

# Database server credentials
# POSTGRES_USER: PostgreSQL superuser (used for initial connection and schema setup)
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: Password for PostgreSQL superuser account
# IMPORTANT: This MUST be set! Generate a strong password.
POSTGRES_PASSWORD=your_secure_postgres_password_here

# POSTGRES_HOST: Hostname or IP address of PostgreSQL server
# Use "postgres" for Docker container networking (docker-compose)
POSTGRES_HOST=postgres

# POSTGRES_PORT: Port number PostgreSQL listens on
POSTGRES_PORT=5432

# POSTGRES_DB: Database name
POSTGRES_DB=trading_reports

# TRADING_USER_PASSWORD: Password for trading_user application account
# This is the user that application services (scraper, analyzer, etc.) use
TRADING_USER_PASSWORD=your_secure_trading_user_password_here

# Application Database Connection Configuration
# =============================================
# These settings are used by application services to connect to the database

# DATABASE_URL: Full PostgreSQL connection string for application services
# Will be auto-constructed if individual components are set
DATABASE_URL=postgresql://trading_user:${TRADING_USER_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/trading_reports?sslmode=require

# DATABASE_POOL_MIN: Minimum number of database connections to maintain in pool
DATABASE_POOL_MIN=2

# DATABASE_POOL_MAX: Maximum number of database connections allowed in pool
# Increase if multiple services need high concurrency
DATABASE_POOL_MAX=20

# DATABASE_SSL_MODE: PostgreSQL SSL/TLS mode
# Options: disable, allow, prefer, require, verify-full
# Default: "require" (Recommended for production)
DATABASE_SSL_MODE=require

# DATABASE_CONNECT_TIMEOUT: Connection timeout in seconds
DATABASE_CONNECT_TIMEOUT=10

# Credential Service Configuration
# ===============================
# Secure encrypted credential storage for trading portal authentication

# CREDENTIAL_ENCRYPTION_KEY: Master encryption key for credential storage
# CRITICAL: Generate with: python scripts/generate_encryption_key.py
# This is a base64-encoded 32-byte Fernet key
# DO NOT commit actual key to version control
CREDENTIAL_ENCRYPTION_KEY=your_base64_encoded_32_byte_fernet_key_here

# CREDENTIAL_SERVICE_PORT: Port for credential service API
CREDENTIAL_SERVICE_PORT=8002

# CREDENTIAL_SERVICE_URL: Internal Docker URL for credential service
CREDENTIAL_SERVICE_URL=http://credential-service:8002

# CREDENTIAL_SERVICE_TIMEOUT: Timeout for credential service API calls (seconds)
CREDENTIAL_SERVICE_TIMEOUT=5

# N8N Workflow Orchestration Configuration
# ========================================
# N8N manages the workflow orchestration

# N8N_HOST: Hostname where N8N is accessible (e.g. trading.yourdomain.com)
N8N_HOST=trading.yourdomain.com

# N8N_PORT: Port where N8N API/UI listens
N8N_PORT=5678

# N8N_PROTOCOL: Protocol for N8N access (http or https)
# Use https in production behind a reverse proxy
N8N_PROTOCOL=https

# WEBHOOK_URL: Public URL where N8N webhook can be reached
WEBHOOK_URL=https://trading.yourdomain.com/

# N8N_DB_USER: PostgreSQL user for N8N database (separate from trading_user)
N8N_DB_USER=n8n_user

# N8N_DB_PASSWORD: Password for N8N's PostgreSQL user
N8N_DB_PASSWORD=your_secure_n8n_db_password_here

# N8N credentials encryption key (optional but recommended)
N8N_ENCRYPTION_KEY=your_secure_n8n_encryption_key

# Timezone Configuration
# ====================
TIMEZONE=UTC

# Node Environment
# ===============
NODE_ENV=production

# AI Provider Configuration
# ========================
# Multi-provider LLM support

# AI_PROVIDER: Explicitly choose which LLM provider to use (optional)
# Options: "anthropic", "groq", "google"
# AI_PROVIDER=anthropic

# LLM_MODEL: Model identifier to use for analysis
# Examples: claude-3-5-sonnet-20241022, mixtral-8x7b-32768, gemini-2.0-flash
LLM_MODEL=claude-3-5-sonnet-20241022

# THINKING_BUDGET_TOKENS: Extended thinking budget for supported models
# Valid range: 1000-32000 tokens
THINKING_BUDGET_TOKENS=5000

# PROMPT_TYPE: Which analysis prompt template to use
# Default: default
PROMPT_TYPE=default

# Anthropic Claude API (LLM_MODEL=claude-*)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Groq API (LLM_MODEL=mixtral-* or llama-*)
GROQ_API_KEY=gsk-your-groq-api-key-here

# Google Gemini API (LLM_MODEL=gemini-*)
GOOGLE_API_KEY=your-google-api-key-here

# Email Configuration
# ===================
# Configuration for receiving and sending emails

# EMAIL_PROVIDER: Which email service to use
EMAIL_PROVIDER=gmail

# SMTP_HOST: SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP_PORT: SMTP server port
SMTP_PORT=587

# SMTP_USER: Email address or username for SMTP authentication
SMTP_USER=your-email@gmail.com

# EMAIL_PASSWORD: App-specific password for SMTP authentication
EMAIL_PASSWORD=your-app-specific-password

# EMAIL_FROM: Sender email address for outgoing notifications
EMAIL_FROM=your-email@gmail.com

# EMAIL_TO: Default recipient email address for reports and alerts
EMAIL_TO=recipient@example.com

# Gmail Bridge Configuration
# ==========================
# Configuration for the Gmail Bridge service that polls Gmail via IMAP

# GMAIL_ADDRESS: Gmail email address to poll
GMAIL_ADDRESS=your-gmail@gmail.com

# GMAIL_APP_PASSWORD: App-specific password for Gmail IMAP access
GMAIL_APP_PASSWORD=your-gmail-app-password

# IMAP_HOST: IMAP server hostname
IMAP_HOST=imap.gmail.com

# IMAP_PORT: IMAP server port
IMAP_PORT=993

# GMAIL_WEBHOOK_URL: Webhook URL where gmail-bridge forwards emails
GMAIL_WEBHOOK_URL=http://n8n:5678/webhook/trading-reports

# GMAIL_POLL_INTERVAL: Seconds between polling Gmail inbox
GMAIL_POLL_INTERVAL=60

# EMAIL_SEARCH_CRITERIA: IMAP search criteria for emails (UNSEEN, ALL, etc.)
EMAIL_SEARCH_CRITERIA=UNSEEN

# EMAIL_SENDER_FILTER: Optional sender email filter
EMAIL_SENDER_FILTER=

# MARK_AS_READ: Mark processed emails as read in Gmail
MARK_AS_READ=false

# WEBHOOK_TIMEOUT: Timeout for webhook requests (seconds)
WEBHOOK_TIMEOUT=30

# Telegram Configuration
# =====================
# Configuration for Telegram notifications

# TELEGRAM_BOT_TOKEN: Bot token from Telegram BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmnoPQRstuvWxyz123456789

# TELEGRAM_CHAT_ID: Telegram chat/group ID to send notifications to
TELEGRAM_CHAT_ID=your-chat-id-here

# Trading Portal Configuration
# ===========================
# Credentials for accessing the trading portal (for scraper service)

# TRADING_PORTAL_URL: Base URL of the trading portal to scrape
TRADING_PORTAL_URL=https://portal.example.com

# TRADING_PORTAL_USERNAME: Username for trading portal login
TRADING_PORTAL_USERNAME=your_portal_username

# TRADING_PORTAL_PASSWORD: Password for trading portal login
TRADING_PORTAL_PASSWORD=your_portal_password

# Playwright Scraper Configuration
# ================================
# Configuration for the Playwright-based web scraper

# SCRAPER_TIMEOUT_MS: Maximum time to wait for page loads (milliseconds)
SCRAPER_TIMEOUT_MS=30000

# SCRAPER_HEADLESS: Run browser in headless mode (no GUI)
SCRAPER_HEADLESS=true

# SCRAPER_DEBUG: Enable detailed scraper logging
SCRAPER_DEBUG=false

# Service Configuration
# ====================
# General configuration for all microservices

# LOG_LEVEL: Global logging level for all services
LOG_LEVEL=INFO

# CORRELATION_ID_HEADER: HTTP header name for distributed tracing
CORRELATION_ID_HEADER=X-Correlation-ID

# SERVICE_NAME: Name of the current service
SERVICE_NAME=trading-report-system

# API Configuration
# ================
# Configuration for REST APIs

# API_HOST: Host to bind API services to
API_HOST=0.0.0.0

# API_PORT: Port for API services
API_PORT=8000

# Webhook Security Configuration
# =============================
# Shared security settings for webhook communication

# WEBHOOK_SECRET_KEY: Shared secret for signing webhook requests
WEBHOOK_SECRET_KEY=your_32_char_min_webhook_secret_key_here

# IP Whitelisting
MAILGUN_IP_RANGES=149.72.0.0/16,161.38.0.0/16
SENDGRID_IP_RANGES=168.245.0.0/16,167.89.0.0/16
CUSTOM_ALLOWED_IPS=

# Rate Limiting
RATE_LIMIT_PER_IP_MINUTE=5
RATE_LIMIT_PER_IP_HOUR=50
RATE_LIMIT_GLOBAL_HOUR=100
RATE_LIMIT_BAN_THRESHOLD=10
RATE_LIMIT_BAN_DURATION_HOURS=1

# Database Maintenance Configuration
# =================================
# Settings for database maintenance tasks

# LOG_RETENTION_DAYS: How many days to keep logs in system_logs table
LOG_RETENTION_DAYS=30

# ARCHIVE_RETENTION_YEARS: How many years to keep archived reports
ARCHIVE_RETENTION_YEARS=2

# BACKUP_RETENTION_DAYS: How many days to keep database backups
BACKUP_RETENTION_DAYS=30

# Monitoring & Alerting
# ====================
# Configuration for monitoring and alerting

# ENABLE_METRICS: Whether to collect performance metrics
ENABLE_METRICS=true

# METRICS_PORT: Port for Prometheus metrics endpoint
METRICS_PORT=9090

# ALERT_ON_FAILED_REPORTS: Send alert email when report processing fails
ALERT_ON_FAILED_REPORTS=true

# Health Monitoring & Error Logging Configuration
# ================================================
# Configuration for system-wide health monitoring, error logging, and alert generation

# ALERT_EMAIL_ADMIN: Email address to receive critical health alerts
ALERT_EMAIL_ADMIN=admin@example.com

# HEALTH_CHECK_INTERVAL: Seconds between automatic health checks
HEALTH_CHECK_INTERVAL=60

# HEALTH_CHECK_TIMEOUT: Maximum seconds to wait for service health response
HEALTH_CHECK_TIMEOUT=5

# ALERT_BATCH_WINDOW: Minutes to batch consecutive failures of same type
ALERT_BATCH_WINDOW=60

# ALERT_AUTO_RESOLVE_WINDOW: Minutes to suppress re-alerts if error resolved
ALERT_AUTO_RESOLVE_WINDOW=5

# ERROR_LOG_RETENTION_DAYS: Days to keep error logs in database
ERROR_LOG_RETENTION_DAYS=30

# HEALTH_CHECK_RETENTION_DAYS: Days to keep health check records
HEALTH_CHECK_RETENTION_DAYS=7

# ENABLE_HEALTH_MONITORING: Enable or disable health monitoring
ENABLE_HEALTH_MONITORING=true

# Retry Configuration
# ===================
# Exponential backoff retry settings (configurable per application)

MAX_SCRAPER_RETRIES=3
MAX_ANALYZER_RETRIES=5
MAX_NOTIFICATION_RETRIES=3
RETRY_BACKOFF_BASE=2

