# Email Webhook Service Configuration

# SECURITY: WEBHOOK_SECRET_KEY
# Required. Minimum 32 characters. Used for validating webhook signatures.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long

# SECURITY: Signature Validation
# Enable/disable signature validation (for testing only, keep enabled in production)
SIGNATURE_VALIDATION_ENABLED=true

# DATABASE: Connection String
# Required. PostgreSQL connection URL for storing security events and IP allowlist
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading_reports

# IP ALLOWLISTING: Static IP Ranges
# Comma-separated CIDR blocks for email providers
# Mailgun official IP ranges
MAILGUN_IP_RANGES=149.72.0.0/16,161.38.0.0/16

# SendGrid official IP ranges
SENDGRID_IP_RANGES=168.245.0.0/16,167.89.0.0/16

# Custom allowed IPs (enterprise, internal services, etc.)
CUSTOM_ALLOWED_IPS=192.168.1.0/24

# IP ALLOWLISTING: Cache Configuration
# Interval in seconds to refresh dynamic IP allowlist from database
IP_ALLOWLIST_CACHE_REFRESH_SECONDS=300

# RATE LIMITING: Per-IP Limits
# Maximum requests per minute from a single IP
RATE_LIMIT_PER_IP_MINUTE=5

# Maximum requests per hour from a single IP
RATE_LIMIT_PER_IP_HOUR=50

# RATE LIMITING: Global Limit
# Maximum requests per hour across all IPs (protects against distributed attacks)
RATE_LIMIT_GLOBAL_HOUR=100

# RATE LIMITING: Authenticated Multiplier
# Multiplier for rate limits when request has valid signature (e.g., 5x allows 25 req/min)
RATE_LIMIT_AUTHENTICATED_MULTIPLIER=5

# IP BANNING: Configuration
# Number of failed authentication attempts before IP is banned
RATE_LIMIT_BAN_THRESHOLD=10

# Duration in hours that IP remains banned
RATE_LIMIT_BAN_DURATION_HOURS=1

# SECURITY ALERTS: Configuration
# Threshold for suspicious pattern detection (e.g., >50 failures in 10 min)
SECURITY_ALERT_THRESHOLD=50

# Enable/disable Telegram alerts for security events
SECURITY_ALERT_TELEGRAM=true

# Debounce window in minutes for alerts (max 1 alert per pattern per window)
SECURITY_ALERT_DEBOUNCE_MINUTES=10

# SERVICE: Configuration
# Service port for the webhook server
SERVICE_PORT=8001

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable/disable all security features (false = development mode only)
WEBHOOK_SECURITY_ENABLED=true

# DATABASE: Data Retention
# Number of days to retain security events (then auto-delete)
SECURITY_EVENT_RETENTION_DAYS=90
