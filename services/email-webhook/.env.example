# Email Webhook Service Configuration

# PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database
# Required: Yes
DATABASE_URL=postgresql://trading_user:secure_password@localhost:5432/trading_reports

# Webhook Signature Verification
# Shared secret used for HMAC-SHA256 signature verification with email providers
# Generate: openssl rand -base64 32
# Required: Yes
WEBHOOK_SIGNATURE_SECRET=your-secret-key-here

# API Key Fallback Authentication
# Optional API key for fallback authentication if signature verification is unavailable
# Required: No
API_KEY_FALLBACK=

# Report Detection Keywords
# Comma-separated list of keywords to detect trading reports
# Case-insensitive matching against email subject and body
# Default: "trading report,analysis,recommendation,trade alert"
REPORT_KEYWORDS=trading report,analysis,recommendation,trade alert

# Trusted Portal Domains
# Comma-separated list of trusted domains for URL filtering
# URLs will be filtered to match these domains with path prefixes
# Format: "domain.com" (path filtering handled in code)
# Default: "protradingskills.com"
TRUSTED_DOMAINS=protradingskills.com

# Rate Limiting Configuration
# Per-sender rate limit: maximum requests per second from a single email address
# Default: 1
RATE_LIMIT_PER_SECOND=1

# Global rate limit: maximum requests per hour across all senders
# Default: 100
RATE_LIMIT_PER_HOUR=100

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO
