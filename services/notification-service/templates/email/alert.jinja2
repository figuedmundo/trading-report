<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .alert { background: #fff3cd; border: 1px solid #ffc107; padding: 15px; border-radius: 4px; }
        .summary { margin: 10px 0; line-height: 1.6; }
        .footer { margin-top: 20px; font-size: 12px; color: #666; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Trading Alert</h1>

        <div class="alert">
            <h3>{{ report_title }}</h3>
            <p><strong>Sentiment:</strong> {{ sentiment|title }} ({{ (confidence_score * 100)|int }}% confidence)</p>

            <div class="summary">
                {{ summary }}
            </div>

            {% if trading_signals %}
            <h4>Key Signals:</h4>
            <ul>
            {% for signal in trading_signals[:3] %}
                <li><strong>{{ signal.action }}</strong> {{ signal.symbol }}{% if signal.target_price %} → ${{ signal.target_price|round(2) }}{% endif %}</li>
            {% endfor %}
            </ul>
            {% endif %}
        </div>

        <div class="footer">
            <p>Generated: {{ timestamp|datetimeformat('%Y-%m-%d %H:%M:%S') }}</p>
        </div>
    </div>
</body>
</html>
