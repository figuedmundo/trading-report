<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; color: #333; line-height: 1.6; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; background: #f9f9f9; }
        .header { background: #2c3e50; color: white; padding: 20px; border-radius: 5px 5px 0 0; }
        .header h1 { margin: 0; font-size: 24px; }
        .content { background: white; padding: 20px; border: 1px solid #ddd; }
        .metric { display: inline-block; margin: 5px 10px 5px 0; padding: 8px 12px; background: #ecf0f1; border-radius: 3px; }
        .metric strong { color: #2c3e50; }
        .signal { background: #f5f5f5; padding: 15px; margin: 15px 0; border-left: 4px solid #3498db; }
        .signal.bullish { border-left-color: #27ae60; }
        .signal.bearish { border-left-color: #e74c3c; }
        .signal.neutral { border-left-color: #95a5a6; }
        .signal .action { font-weight: bold; font-size: 16px; }
        .signal .details { margin-top: 8px; font-size: 14px; }
        .footer { background: #ecf0f1; padding: 15px; text-align: center; font-size: 12px; color: #7f8c8d; border-radius: 0 0 5px 5px; }
        .footer a { color: #3498db; text-decoration: none; }
        .summary { margin: 15px 0; line-height: 1.8; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Trading Analysis Report</h1>
        </div>

        <div class="content">
            {% if html_analysis %}
            {{ html_analysis | safe }}
            {% elif raw_analysis %}
            <h3>Full Analysis (Raw)</h3>
            <div style="background: #fff; padding: 15px; border: 1px solid #eee; border-radius: 3px; white-space: pre-wrap; font-family: monospace; font-size: 13px;">
{{ raw_analysis }}
            </div>
            {% endif %}
        </div>

        <div class="footer">
            <p><strong>Generated:</strong> {{ timestamp|datetimeformat('%Y-%m-%d %H:%M:%S') }}</p>
            <p><strong>Analysis Provider:</strong> {{ ai_provider|title }} | <strong>Model:</strong> {{ model_used }} | <strong>Prompt:</strong> {{ prompt_type }}</p>
            {% if report_url %}<p><a href="{{ report_url }}">View Full Report</a></p>{% endif %}
        </div>
    </div>
</body>
</html>
