# AI Analysis Engine Configuration

# LLM Model Selection - REQUIRED
# Specifies which LLM model to use. Provider is auto-detected from model prefix:
#   - claude-* (e.g., claude-3-5-sonnet-20241022) uses Anthropic provider
#   - mixtral-* or llama-* (e.g., mixtral-8x7b-32768) uses Groq provider
#   - gemini-* (e.g., gemini-2.0-flash) uses Google provider
LLM_MODEL=claude-3-5-sonnet-20241022

# Extended Thinking Budget (tokens) - OPTIONAL
# Default: 5000 (must be between 1000 and 32000)
# Controls the token budget for LLM extended thinking (when supported by provider)
# Higher values: more thorough analysis but slower and more costly
# Set to 0 to disable extended thinking
# Note: Groq provider does not support thinking (budget ignored)
THINKING_BUDGET_TOKENS=5000

# AI Provider API Keys - At least one required (based on LLM_MODEL)
# Only the API key for the detected provider (from LLM_MODEL) is required
# Anthropic Claude API key (required if using claude-* models)
ANTHROPIC_API_KEY=sk-ant-...

# Groq API key (required if using mixtral-* or llama-* models)
GROQ_API_KEY=gsk-...

# Google Gemini API key (required if using gemini-* models)
GOOGLE_API_KEY=...

# Service Configuration
SERVICE_PORT=8002
LOG_LEVEL=INFO
ANALYSIS_TIMEOUT=30

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading_reports
