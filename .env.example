# PostgreSQL Database Configuration
# ================================
# These variables configure the PostgreSQL database that stores all trading reports,
# analyses, and system logs. All services depend on these settings.

# Database server credentials
# POSTGRES_USER: PostgreSQL superuser (used for initial connection and schema setup)
# Default: "postgres" (standard PostgreSQL default)
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: Password for PostgreSQL superuser account
# IMPORTANT: This MUST be set for Docker initialization!
# Generate strong password: openssl rand -base64 32
# DO NOT commit actual credentials to version control
POSTGRES_PASSWORD=your_secure_postgres_password_here

# POSTGRES_HOST: Hostname or IP address of PostgreSQL server
# Use "postgres" for Docker container networking (docker-compose)
# Use "localhost" or IP for direct connection from host
# Default: "localhost"
POSTGRES_HOST=postgres

# POSTGRES_PORT: Port number PostgreSQL listens on
# Default: 5432
POSTGRES_PORT=5432

# POSTGRES_DB: Default database name created by PostgreSQL
# Will be overwritten by init_database.py which creates trading_reports database
# Default: "trading_reports"
POSTGRES_DB=trading_reports

# TRADING_USER_PASSWORD: Password for trading_user application account
# This is the user that application services (scraper, analyzer, etc.) use
# If not specified, defaults to POSTGRES_PASSWORD
# Generate strong password: openssl rand -base64 32
TRADING_USER_PASSWORD=your_secure_trading_user_password_here

# Application Database Connection Configuration
# =============================================
# These settings are used by application services to connect to the database

# DATABASE_URL: Full PostgreSQL connection string for application services
# Format: postgresql://username:password@host:port/database?sslmode=mode
# Will be auto-constructed if individual components are set
# Example: postgresql://trading_user:password@postgres:5432/trading_reports?sslmode=require
DATABASE_URL=postgresql://trading_user:${TRADING_USER_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/trading_reports?sslmode=require

# DATABASE_POOL_MIN: Minimum number of database connections to maintain in pool
# Default: 2
# Increase if high concurrent request rate expected
DATABASE_POOL_MIN=2

# DATABASE_POOL_MAX: Maximum number of database connections allowed in pool
# Default: 10
# Increase if multiple services need high concurrency
# Decrease if hitting connection limits on PostgreSQL
DATABASE_POOL_MAX=10

# DATABASE_SSL_MODE: PostgreSQL SSL/TLS mode
# Options:
#   - disable: No SSL (insecure, development only)
#   - allow: SSL if available
#   - prefer: Use SSL if server supports it
#   - require: Always use SSL (recommended for production)
#   - verify-full: SSL + verify server certificate
# Default: "require"
DATABASE_SSL_MODE=require

# DATABASE_CONNECT_TIMEOUT: Connection timeout in seconds
# Default: 10 (seconds)
DATABASE_CONNECT_TIMEOUT=10

# Credential Service Configuration
# ===============================
# Secure encrypted credential storage for trading portal authentication

# CREDENTIAL_ENCRYPTION_KEY: Master encryption key for credential storage
# CRITICAL: Generate with: python scripts/generate_encryption_key.py
# This is a base64-encoded 32-byte Fernet key (AES-128 CBC + HMAC SHA256)
# IMPORTANT SECURITY NOTES:
#   - Store in secure location (.env with chmod 600)
#   - Keep development and production keys separate
#   - Rotate periodically (requires re-encryption of all credentials)
#   - DO NOT commit to version control
# Example: gAAAAABh7kPY8V9_wXCvf3Hn_R0lH0lh5eQkLZJ8...
CREDENTIAL_ENCRYPTION_KEY=your_base64_encoded_32_byte_fernet_key_here

# CREDENTIAL_SERVICE_PORT: Port for credential service API
# Default: 8002
CREDENTIAL_SERVICE_PORT=8002

# CREDENTIAL_SERVICE_URL: Internal Docker URL for credential service
# Used by scraper service to retrieve credentials
# For Docker: http://credential-service:8002
# For local: http://localhost:8002
CREDENTIAL_SERVICE_URL=http://credential-service:8002

# CREDENTIAL_SERVICE_TIMEOUT: Timeout for credential service API calls (seconds)
# Default: 5
CREDENTIAL_SERVICE_TIMEOUT=5

# N8N Workflow Orchestration Configuration
# ========================================
# N8N manages the workflow orchestration, triggering services based on report status changes

# N8N_HOST: Hostname where N8N is accessible
# Default: "localhost"
N8N_HOST=localhost

# N8N_PORT: Port where N8N API/UI listens
# Default: 5678
N8N_PORT=5678

# N8N_PROTOCOL: Protocol for N8N access (http or https)
# Default: "http" (use https in production)
N8N_PROTOCOL=http

# WEBHOOK_URL: Public URL where N8N webhook can be reached by external services
# Used for incoming email webhooks, external triggers
# Example: https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/

# N8N_DB_USER: PostgreSQL user for N8N database (separate from trading_user)
# N8N stores its workflow definitions in this database
# Default: "n8n_user"
N8N_DB_USER=n8n_user

# N8N_DB_PASSWORD: Password for N8N's PostgreSQL user
# Generate strong password: openssl rand -base64 32
N8N_DB_PASSWORD=your_secure_n8n_db_password_here

# Timezone Configuration
# ====================
TIMEZONE=UTC

# Node Environment
# ===============
# Options: "development", "production"
# Use "development" for local testing with verbose logging
# Use "production" for deployments with performance optimizations
NODE_ENV=production

# AI Provider Configuration
# ========================
# Multi-provider LLM support with automatic provider detection from model name
# You can either:
# 1. Let the system auto-detect provider from LLM_MODEL (recommended)
# 2. Explicitly set AI_PROVIDER for direct control

# AI_PROVIDER: Explicitly choose which LLM provider to use
# Options: "anthropic", "groq", "google"
# If not set, provider is auto-detected from LLM_MODEL prefix
# Default: (auto-detect from LLM_MODEL)
# OPTIONAL - Only set this if you want to override auto-detection
# AI_PROVIDER=anthropic

# LLM_MODEL: Model identifier to use for analysis
# The provider is auto-detected from the model name prefix:
#   - claude-* → Anthropic API (if AI_PROVIDER not explicitly set)
#   - mixtral-*, llama-* → Groq API (if AI_PROVIDER not explicitly set)
#   - gemini-* → Google Gemini API (if AI_PROVIDER not explicitly set)
#
# Examples:
#   - claude-3-5-sonnet-20241022 (Anthropic)
#   - claude-opus-4-1 (Anthropic)
#   - mixtral-8x7b-32768 (Groq)
#   - llama-2-70b-chat (Groq)
#   - llama-3.1-70b-versatile (Groq)
#   - gemini-2.0-flash (Google)
#   - gemini-pro (Google)
#   - gemini-2.0-flash-thinking-exp (Google with thinking)
#
# Default: claude-3-5-sonnet-20241022
LLM_MODEL=claude-3-5-sonnet-20241022

# THINKING_BUDGET_TOKENS: Extended thinking budget for supported models
# Valid range: 1000-32000 tokens
# Supported by: Anthropic Claude (full support), Google Gemini (best effort)
# Not supported by: Groq (will be ignored with INFO log)
# Default: 5000
# IMPORTANT: Thinking increases latency (5-10 seconds) and API costs
# Set to 0 to disable thinking completely
THINKING_BUDGET_TOKENS=5000

# PROMPT_TYPE: Which analysis prompt template to use
# Available templates: default, detailed, conservative
# Custom templates: Add your own .md file to services/ai-analyzer/src/llm/prompts/ folder
#
# Examples:
#   - default: Balanced analysis with all sections
#   - detailed: Comprehensive analysis with extended summaries and reasoning
#   - conservative: High-confidence signals only (>75% confidence threshold)
#   - custom_template: If you create services/ai-analyzer/src/llm/prompts/custom_template.md
#
# Default: default
PROMPT_TYPE=default

# Anthropic Claude API
# Get API key from: https://console.anthropic.com/account/keys
# Only required if using Claude models (LLM_MODEL=claude-*)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Groq API (alternative, faster and cheaper for some models)
# Get API key from: https://console.groq.com/keys
# Only required if using Groq models (LLM_MODEL=mixtral-* or LLM_MODEL=llama-*)
GROQ_API_KEY=gsk-your-groq-api-key-here

# Google Gemini API
# Get API key from: https://ai.google.dev/
# Only required if using Gemini models (LLM_MODEL=gemini-*)
GOOGLE_API_KEY=your-google-api-key-here

# Email Configuration
# ===================
# Configuration for receiving and sending emails

# EMAIL_PROVIDER: Which email service to use
# Options: "gmail", "outlook", "custom_smtp"
EMAIL_PROVIDER=gmail

# SMTP_HOST: SMTP server hostname
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
SMTP_HOST=smtp.gmail.com

# SMTP_PORT: SMTP server port
# Gmail TLS: 587
# Gmail SSL: 465
SMTP_PORT=587

# SMTP_USER: Email address or username for SMTP authentication
# For Gmail: your-email@gmail.com
SMTP_USER=your-email@gmail.com

# EMAIL_PASSWORD: App-specific password for SMTP authentication
# IMPORTANT: NOT your regular email password!
# For Gmail: Generate app-specific password from account security settings
# DO NOT commit actual credentials
EMAIL_PASSWORD=your-app-specific-password

# EMAIL_FROM: Sender email address for outgoing notifications
# Default: same as SMTP_USER
EMAIL_FROM=your-email@gmail.com

# EMAIL_TO: Default recipient email address for reports and alerts
# Can be overridden per service configuration
EMAIL_TO=recipient@example.com

# Telegram Configuration
# =====================
# Configuration for Telegram notifications

# TELEGRAM_BOT_TOKEN: Bot token from Telegram BotFather
# Get from: https://t.me/BotFather
# Format: 123456789:ABCdefGHIjklmnoPQRstuvWxyz123456789
DO_NOT_COMMIT_TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmnoPQRstuvWxyz123456789

# TELEGRAM_CHAT_ID: Telegram chat/group ID to send notifications to
# Get your ID from: https://t.me/userinfobot
TELEGRAM_CHAT_ID=your-chat-id-here

# Trading Portal Configuration
# ===========================
# Credentials for accessing the trading portal (for scraper service)
# FALLBACK: Used when reports.credential_id is NULL (for backward compatibility)
# MIGRATION: New reports should use CREDENTIAL_SERVICE_URL for database credentials

# TRADING_PORTAL_URL: Base URL of the trading portal to scrape
# Example: https://reports.broker.com
TRADING_PORTAL_URL=https://portal.example.com

# TRADING_PORTAL_USERNAME: Username for trading portal login
# FALLBACK: Used if credential not found in database (deprecated in favor of credential service)
TRADING_PORTAL_USERNAME=your_portal_username

# TRADING_PORTAL_PASSWORD: Password for trading portal login
# FALLBACK: Used if credential not found in database (deprecated in favor of credential service)
# DO NOT commit actual credentials
TRADING_PORTAL_PASSWORD=your_portal_password

# Playwright Scraper Configuration
# ================================
# Configuration for the Playwright-based web scraper

# SCRAPER_TIMEOUT_MS: Maximum time to wait for page loads (milliseconds)
# Default: 30000 (30 seconds)
SCRAPER_TIMEOUT_MS=30000

# SCRAPER_HEADLESS: Run browser in headless mode (no GUI)
# Options: "true" (production), "false" (debugging with visible browser)
# Default: "true"
SCRAPER_HEADLESS=true

# SCRAPER_DEBUG: Enable detailed scraper logging
# Options: "true", "false"
# Default: "false"
SCRAPER_DEBUG=false

# Service Configuration
# ====================
# General configuration for all microservices

# LOG_LEVEL: Global logging level for all services
# Options: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
# Default: "INFO"
LOG_LEVEL=INFO

# CORRELATION_ID_HEADER: HTTP header name for distributed tracing
# Used to track reports across all services
# Default: "X-Correlation-ID"
CORRELATION_ID_HEADER=X-Correlation-ID

# SERVICE_NAME: Name of the current service (for logging)
# Will be overridden per service instance
# Options: "email_webhook", "scraper_service", "ai_analyzer", "notification_service", "credential_service", "n8n"
SERVICE_NAME=trading-report-system

# API Configuration
# ================
# Configuration for REST APIs

# API_HOST: Host to bind API services to
# Use "0.0.0.0" for Docker containers (accessible from any interface)
# Use "127.0.0.1" for localhost-only access
API_HOST=0.0.0.0

# API_PORT: Port for API services
# Email Webhook: 8000
# Scraper Service: 8001
# Credential Service: 8002
# AI Analyzer: 8003
# Notification Service: 8004
API_PORT=8000

# Database Maintenance Configuration
# =================================
# Settings for database maintenance tasks

# LOG_RETENTION_DAYS: How many days to keep logs in system_logs table
# After this period, logs are moved to system_logs_archive table
# Default: 30
LOG_RETENTION_DAYS=30

# ARCHIVE_RETENTION_YEARS: How many years to keep archived reports
# After this period, archived reports can be purged
# Default: 2
ARCHIVE_RETENTION_YEARS=2

# BACKUP_RETENTION_DAYS: How many days to keep database backups
# Older backups are automatically deleted
# Default: 30
BACKUP_RETENTION_DAYS=30

# Monitoring & Alerting
# ====================
# Configuration for monitoring and alerting

# ENABLE_METRICS: Whether to collect performance metrics
# Options: "true", "false"
# Default: "true"
ENABLE_METRICS=true

# METRICS_PORT: Port for Prometheus metrics endpoint
# Default: 9090
METRICS_PORT=9090

# ALERT_ON_FAILED_REPORTS: Send alert email when report processing fails
# Options: "true", "false"
# Default: "true"
ALERT_ON_FAILED_REPORTS=true

# ALERT_EMAIL: Email address to receive failure alerts
# If different from EMAIL_TO
ALERT_EMAIL=ops@example.com

# Health Monitoring & Error Logging Configuration
# ================================================
# Configuration for system-wide health monitoring, error logging, and alert generation

# ALERT_EMAIL_ADMIN: Email address to receive critical health alerts
# Alerts for CRITICAL errors are sent to this address
# Default: admin@example.com
ALERT_EMAIL_ADMIN=admin@example.com

# HEALTH_CHECK_INTERVAL: Seconds between automatic health checks
# Default: 60 (perform health checks every 60 seconds)
HEALTH_CHECK_INTERVAL=60

# HEALTH_CHECK_TIMEOUT: Maximum seconds to wait for service health response
# Default: 5 (service marked as "down" if doesn't respond within 5 seconds)
HEALTH_CHECK_TIMEOUT=5

# ALERT_BATCH_WINDOW: Minutes to batch consecutive failures of same type
# Default: 60 (send maximum one alert per hour for same error type)
ALERT_BATCH_WINDOW=60

# ALERT_AUTO_RESOLVE_WINDOW: Minutes to suppress re-alerts if error resolved
# Default: 5 (if error goes away for 5 minutes, reset the failure counter)
ALERT_AUTO_RESOLVE_WINDOW=5

# ERROR_LOG_RETENTION_DAYS: Days to keep error logs in database
# Default: 30 (errors older than 30 days are deleted)
ERROR_LOG_RETENTION_DAYS=30

# HEALTH_CHECK_RETENTION_DAYS: Days to keep health check records
# Default: 7 (health checks older than 7 days are deleted)
HEALTH_CHECK_RETENTION_DAYS=7

# ENABLE_HEALTH_MONITORING: Enable or disable health monitoring
# Options: "true" (enabled), "false" (disabled)
# Default: "true"
ENABLE_HEALTH_MONITORING=true

# Retry Configuration
# ===================
# Exponential backoff retry settings (configurable per application)

# MAX_SCRAPER_RETRIES: Maximum retry attempts for scraping failures
# Default: 3
MAX_SCRAPER_RETRIES=3

# MAX_ANALYZER_RETRIES: Maximum retry attempts for AI analysis failures
# Default: 5
MAX_ANALYZER_RETRIES=5

# MAX_NOTIFICATION_RETRIES: Maximum retry attempts for notification delivery
# Default: 3
MAX_NOTIFICATION_RETRIES=3

# RETRY_BACKOFF_BASE: Base for exponential backoff calculation (seconds)
# Retry delay = RETRY_BACKOFF_BASE ^ retry_count
# Default: 2 (means: 2s, 4s, 8s, 16s, etc.)
RETRY_BACKOFF_BASE=2

# Testing Configuration
# ====================
# Configuration for running tests (development only)

# TEST_DATABASE_URL: Separate database URL for testing
# Should point to a test database (not production!)
# If not set, tests use DATABASE_URL
# TEST_DATABASE_URL=postgresql://test_user:password@localhost:5432/trading_reports_test

# FIXTURES_PATH: Path to test fixtures and sample data
# Default: "./tests/fixtures"
# FIXTURES_PATH=./tests/fixtures

# Notes
# =====
# 1. Never commit this file with actual credentials (.env should be in .gitignore)
# 2. Copy .env.example to .env and fill in actual values
# 3. Passwords should be generated with: openssl rand -base64 32
# 4. Encryption key should be generated with: python scripts/generate_encryption_key.py
# 5. Keep .env file secure and restrict file permissions: chmod 600 .env
# 6. Rotate API keys and passwords regularly (at least quarterly)
# 7. Use different credentials for development vs production
# 8. For Docker: Set DATABASE_HOST=postgres (container name)
# 9. For local development: Set DATABASE_HOST=localhost
# 10. CREDENTIAL_ENCRYPTION_KEY is CRITICAL - store securely and rotate periodically
